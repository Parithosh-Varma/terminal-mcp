{
  "name": "terminal-mcp",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parithosh-Varma/terminal-mcp.git"
  },
  "type": "module",
  "description": "Sandboxed terminal, filesystem, git and system MCP server for Claude and ChatGPT",
  "bin": {
    "terminal-mcp": "bin/terminal-mcp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "relay": "node dist/relay-agent.js",
    "up": "bash scripts/up.sh",
    "serve:json": "node dist/index.js --http --port 8787 --json-response",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "pages:deploy": "wrangler pages deploy site --project-name terminal-mcp --branch main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
