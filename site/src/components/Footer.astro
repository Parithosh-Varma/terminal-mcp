  <div class="wrap footer-inner">
    <div>
      <a href={GITHUB} target="_blank" rel="noopener">github</a>
      <span class="sep">·</span>
      <a href={`${RELAY}/`}>relay status</a>
      <span class="sep">·</span>
      <span>MIT license</span>
    </div>
    <div>
      <span class="mono-note">© {year} terminal-mcp — sandboxed by default</span>
    </div>
  </div>
</footer>
