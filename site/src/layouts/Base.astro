---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A sandboxed terminal, filesystem, git and system MCP server for Claude and ChatGPT. 67 tools, one workspace per session, kernel-sandboxed." } = Astro.props;
const page = `${title} — terminal-mcp`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={page} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0d10" />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main transition:name="main" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll. Re-initialised after every client-side navigation.
      function initReveal() {
        const nodes = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
        if (!("IntersectionObserver" in window)) {
          nodes.forEach((el) => el.classList.add("in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -30px 0px" },
        );
        nodes.forEach((el) => io.observe(el));
      }
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
